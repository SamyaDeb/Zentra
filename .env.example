# ==========================================
# ZENTRA - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local and fill in your values

# ==========================================
# STELLAR / SOROBAN CONFIGURATION
# ==========================================

# TrustCircles contract ID. Current mainnet deployment:
NEXT_PUBLIC_CONTRACT_ID=CATTV5OCFI6TZQF26ZROIEP2RCY7M3G3OYZTS4IZGPWWXREN337O5K4Q

# Native XLM Token SAC address. Current mainnet address:
NEXT_PUBLIC_NATIVE_TOKEN_ID=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA

# ==========================================
# NETWORK CONFIGURATION
# ==========================================
# Safe default is Stellar Testnet. Set this to mainnet only for a production
# build after the mainnet contract has been initialized and verified.
NEXT_PUBLIC_STELLAR_NETWORK=mainnet

# Horizon API (default: https://horizon-testnet.stellar.org)
# Soroban RPC (default: https://soroban-testnet.stellar.org)

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
# Admin address is set in config/stellarConfig.ts
# Default: GBALWWEQCFTHQ6FXSBRSB7X7WX5VVYBOVGT3GB34VABGY4MTB2F52FGX

# ==========================================
# DEPLOYMENT (for stellar CLI)
# ==========================================
# When deploying, ensure you have:
# 1. Stellar CLI installed: cargo install stellar-cli
# 2. Funded testnet account (use Friendbot)
# 3. Rust toolchain with wasm32-unknown-unknown target
